# Copy this file to .env and fill in your own values.
# Generate an API key in Obsidian: Settings -> Community plugins -> Local REST API (or the
# equivalent plugin you use for headless access), then paste it below.
OBSIDIAN_API_KEY=

# Usually your host UID/GID, so files written by the container are owned by you, not root.
# Run `id -u` and `id -g` to find these.
UID=1000
GID=1000
